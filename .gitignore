# fish rewrites this per machine; regenerate locally (fish_user_paths etc.)
fish/.config/fish/fish_variables

# machine-local secrets; never commit real keys
fish/.config/fish/conf.d/secrets.fish

# herdr runtime state: track only config.toml and plugins/ (logs, sockets,
# session.json, session-snapshots, .plugins.lock are machine-local)
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
!herdr/.config/herdr/plugins/

omarchy/.config/omarchy/plugins/
